{
  "name": "project_tours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "i18n:check": "node scripts/check-translations.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "media:download": "node --env-file=.env.local scripts/media-download.mjs",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run src/__tests__/pub-game-store.test.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "maplibre-gl": "^6.11.1",
    "mongodb": "^6.21.0",
    "next": "16.3.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
