# Copy to .env.local and fill in what you need. Never commit .env.local.
# (Maps and walking routes are free and keyless; only the Hidden Pubs multiplayer game needs a database.)

# Hidden Pubs multiplayer: MongoDB Atlas connection string (server only: never give it a NEXT_PUBLIC_ prefix).
# Atlas → cluster "hiddenantwerp" → Connect → Drivers. The URI must name the database: /HiddenAntwerpGeneral (case-sensitive).
# A password with @ : / ? # % must be URL-encoded. Required in production; without it, development keeps
# games in memory. Create the collections and indexes once (and after db/mongo-schema.mjs changes):
#   npm run db:setup        then check with: npm run db:check
# Atlas → Network Access must allow the server: your own IP for local use; for Vercel 0.0.0.0/0
# (Vercel has no fixed IPs) or the Atlas–Vercel integration.
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@hiddenantwerp.pbtojhh.mongodb.net/HiddenAntwerpGeneral?retryWrites=true&w=majority
#
# Hidden Pubs evidence photos/videos: Vercel Blob (server only). Vercel project → Storage → Create → Blob;
# connecting the store to the project adds this variable. Files are stored PRIVATE and shown only through
# /api/games/[code]/media/file. Required in production; without it, development keeps uploads in memory.
# BLOB_READ_WRITE_TOKEN=
#
# NEVER on Vercel: PUB_GAME_MEMORY_STORES=true lets a production build keep Hidden Pubs games and
# photos in memory. Only the browser tests (playwright.config.ts) set it.
#
# Optional: a SEPARATE database for the database tests (npm run test:db), e.g. the same cluster with
# /HiddenAntwerpGeneral_test. Its name must contain "test" (the tests refuse anything else). They delete only
# their own games, but never point this at production. Without it, those tests are skipped.
# TEST_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@hiddenantwerp.pbtojhh.mongodb.net/HiddenAntwerpGeneral_test?retryWrites=true&w=majority

# Optional: map style / tiles. Default: OpenFreeMap (free, no key, commercial use allowed).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional: show the playtest tools in a production build (e.g. Vercel).
# Remove before real players use the site. (The build prints a warning while it's set.)
# NEXT_PUBLIC_PLAYTEST_TOOLS=true

# Development only: open the dev server from a phone on the same Wi-Fi.
# Your computer's exact LAN IP address(es), comma-separated (no wildcards).
# Not public (no NEXT_PUBLIC_ prefix); has no effect on production builds.
# DEV_ALLOWED_ORIGINS=192.168.1.23
